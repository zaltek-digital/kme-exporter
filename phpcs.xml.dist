<?xml version="1.0"?>
<ruleset name="kme-exporter">
	<description>PHP coding standards for the KME Exporter plugin.</description>

	<file>kme-exporter.php</file>
	<file>includes</file>
	<arg name="extensions" value="php"/>

	<!-- Production code only: test scaffolding and dependencies have their own conventions. -->
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<!-- WordPress house style + documentation rules. -->
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Every global symbol is prefixed KME_Export / KME_Exporter / KME_EXPORT_ / kme_export_. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="KME_Export"/>
				<element value="KME_Exporter"/>
				<element value="KME_EXPORT"/>
				<element value="kme_export"/>
			</property>
		</properties>
	</rule>

	<!-- One text domain, declared in the plugin header. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="kme-exporter"/>
			</property>
		</properties>
	</rule>

	<!-- Target the minimum supported runtime (see the plugin header). -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="minimum_wp_version" value="6.4"/>
</ruleset>
