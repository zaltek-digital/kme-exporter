{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zaltek-digital/kme-exporter/schema/options.schema.json",
  "title": "KME export options (options.json)",
  "type": "object",
  "required": [
    "presets",
    "presets_sha256"
  ],
  "properties": {
    "presets": {
      "type": "array",
      "description": "KME's shared preset texts (preset_text_list), in order.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "text",
          "sha256"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "What create-block/todo-list blocks name in their text attribute."
          },
          "text": {
            "type": "string",
            "description": "The wysiwyg HTML as stored."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "presets_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
